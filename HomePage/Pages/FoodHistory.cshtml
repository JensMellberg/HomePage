@page
@model HomePage.Pages.FoodHistoryModel
@{
    ViewData["Title"] = "Mathistorik";
}

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<div class="page-wrapper food-info-page">
    <div class="food-information-wrapper">
        <span style="font-size: 24px">@Model.Food.Name</span>
        @if (Model.Food.RecipeUrl != null) {
            <a class="modern-button secondary" href="@Model.Food.RecipeUrl">Länk till recept</a>
        }
        @if (Model.Food.Notes != null)
        {
            <span>@Model.Food.Notes</span>
        }
        <div class="input-wrapper">
            <span>Kategorier</span>
            <div class="category-shower">@string.Join(", ", Model.Food.Categories.Select(xa => xa.Name))</div>
        </div>
        <div class="input-wrapper">
            <span>Ingredienser</span>
            <div class="category-shower">
                @foreach (var fi in Model.Food.FoodIngredients.Select(xa => xa.ToIngredientInstance()))
                {
                    <div>@fi.Ingredient.Name @fi.GetStaticDisplayString()</div>
                }
            </div>
        </div>
    </div>
    <div class="food-grid-wrapper">
        <div class="food-grid food-history-grid">
            @foreach (var row in Model.HistoryList)
            {
                <div class="food-row">
                    <span class="food-grid-cell">@DateHelper.ToNumberedDateString(row.dayFood.Date)</span>
                    <span class="food-grid-cell">@row.dayFood.CombinedName</span>
                    <span class="food-grid-cell ranking">@row.jensRanking</span>
                    @if (!string.IsNullOrEmpty(row.jensNote)) {
                        <span class="food-grid-cell note">
                            <span>@row.jensNote</span>
                        </span>
                    }
                    <span class="food-grid-cell ranking">@row.annaRanking</span>
                    @if (!string.IsNullOrEmpty(row.annaNote))
                    {
                        <span class="food-grid-cell note">
                            <span>@row.annaNote</span>
                        </span>
                    }
                </div>
            }
        </div>
    </div>
</div>
