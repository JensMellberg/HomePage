@page
@model HomePage.Pages.WeekFoodModel
@{
    ViewData["Title"] = "Veckans mat";
}

<button class="modern-button secondary" type="button" onclick="showShoppingList()" style="position: absolute; top: 5px; right: 5px;">Skapa handlingslista</button>
<div class="page-wrapper mainscreen">
    <div class="goal-wrapper">
        @foreach (var goal in Model.WeekGoals.Where(x => !x.IsBad)) {
            <span style="@goal.Style">
                @goal.Category: @goal.Completed/@goal.Goal
            </span>
        }
    </div>
    <div class="goal-wrapper">
        @foreach (var goal in Model.WeekGoals.Where(x => x.IsBad))
        {
            <span style="@goal.Style">
                @goal.Category: @goal.Completed/@goal.Goal
            </span>
        }
    </div>

    <div class="week-food-header">
        <a class="week-navigation" href="WeekFood?@Model.PrevWeekQs">← Föregående</a>
        <span>Vecka @Model.Week</span>
        <a class="week-navigation" href="WeekFood?@Model.NextWeekQs">Nästa →</a>
    </div>

    <input type="hidden" id="loggedInPerson" value="@Model.LoggedInPerson?.UserName" />
    <div class="food-grid-wrapper">
    <div class="food-grid">
        @foreach (var dayFood in Model.DayFoods) {
            <div class="food-row">
                <span class="weekday-cell food-grid-cell small-cell"> @DateHelper.WeekNumberToString[(int)dayFood.Date.DayOfWeek] @dayFood.Date.Day/@dayFood.Date.Month</span>
                <div class="food-cell food-grid-cell">
                    @if (!string.IsNullOrEmpty(dayFood.MainFood?.RecipeUrl))
                    {
                        <div class="recipelinkplaceholder" linkurl="@dayFood.MainFood?.RecipeUrl"></div>
                    }
                    @if (dayFood.MainFood?.InFolder == true)
                    {
                        <span class="recipe-button">📗</span>
                    }
                    @if (dayFood.MainFood?.NeedsPreparation == true || dayFood.SideDishes.Any(x => x.NeedsPreparation))
                    {
                        <span class="recipe-button">⏱️</span>
                    }
                    @if (dayFood.MainFood?.HasHistory == true)
                    {
                        <div class="foodhistoryplaceholder" foodId="@dayFood.MainFood.Id"></div>
                    }
                    @if(dayFood.MainFoodId == Guid.Empty) {
                        <a href="CreateDayFood?@DateHelper.FormatDateForQueryString(dayFood.Date)">Lägg till mat</a>
                    }
                    else if (!Model.IsLoggedIn || Model.FoodRankings[DateHelper.ToKey(dayFood.Date)].Any(x => !string.IsNullOrEmpty(x.FoodId))) {
                        <span>@dayFood.CombinedName</span>
                    }
                    else {
                        <a href="CreateDayFood?@DateHelper.FormatDateForQueryString(dayFood.Date)">@dayFood.CombinedName</a>
                    }
                </div>
                @foreach (var ranking in Model.FoodRankings[DateHelper.ToKey(dayFood.Date)]) {
                    if (Model.IsInFuture(ranking.Date) || dayFood.MainFoodId == Guid.Empty)
                        {
                        <span class="food-grid-cell small-cell"> </span>
                    }
                    else {
                        <span class="food-grid-cell small-cell" onclick="makeRanking('@DateHelper.ToKey(ranking.Date)', '@ranking.Person')"> @ranking.Person: @ranking.RankingText</span>
                    }
                }
            </div>
        }
    </div>
    </div>
</div>

<script src="~/js/homeButton.js" asp-append-version="true"></script>
<script src="~/js/StarRanker.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/weekfood.css" asp-append-version="true" />
<script>
    var foodRankings = @Json.Serialize(Model.FoodRankings);

    function showShoppingList() {
        const wrapper = document.createElement('div')
        wrapper.className = 'dates-wrapper'
        const dateFrom = document.createElement('input')
        dateFrom.type = 'date'
        dateFrom.value = '@Html.Raw(Model.ShopListFrom)'
        wrapper.appendChild(dateFrom)
        const dateTo = document.createElement('input')
        dateTo.type = 'date'
        dateTo.value = '@Html.Raw(Model.ShopListTo)'
        wrapper.appendChild(dateTo)

        Alert.openDialogWithElement(wrapper, [
            {text: 'Skapa lista', action: () => { window.location.href = 'CreateShoppingList?from=' + dateFrom.value + '&to=' + dateTo.value; }},
            {text: 'Avbryt', action: () => {Popup.closePopup();}}
        ])
    }

     function makeRanking(date, person) {
         const loggedInPerson = $('#loggedInPerson').val()
         if (!loggedInPerson) {
             window.location.href = 'Login'
             return
         }

         if (person != loggedInPerson) {
             return
         }

        const prevRanking = foodRankings[date].filter(x => x.person === person)[0]
        StarRanker.create((r, n) => submitRanking(date, person, r, n), undefined, undefined, prevRanking.note, prevRanking.ranking)
    }

    function submitRanking(date, person, ranking, note) {
        if (!ranking) {
            return
        }

         $.ajax({
            type: "POST",
            url: "/WeekFood",
            data: {
                date: date,
                person: person,
                ranking: ranking,
                note: note
            },
            success: (e) => window.location.reload()
        });
    }
</script>