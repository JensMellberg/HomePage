@page
@model HomePage.Pages.CreateDayFoodModel
@{
    ViewData["Title"] = "Skapa mat";
}

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<div class="page-wrapper mainscreen">
    <input type="hidden" id="datekey" value="@Model.DateQs" />
    <input type="hidden" id="datekeyFoW" value="@Model.DateQsFirstOfWeek" />
    <form class="dayfood-form" method="post" id="theForm">
        <input type="hidden" id="sideDishIds" name="sideDishIds" />
        <input type="hidden" name="day" value="@Model.DateKey" id="dateKeyCompact"/>
        <input type="hidden" name="delete" id="deleteHidden" value="" />
        <div id="autoSearchPlaceholder"></div>
        <div class="input-wrapper">
            <select name="foodId" id="foodSelector">
                @foreach (var food in Model.ExistingFood) {
                    if (food.Id == Model.FoodIdFromQueryString || (Model.FoodIdFromQueryString == Guid.Empty && Model.DayFood?.MainFoodId == food.Id)) {
                        <option value="@food.Id" selected> @food.Name</option>
                    } else {
                        <option value="@food.Id"> @food.Name</option>
                    }
                }
            </select>
        </div>
        <div class="button-section-wrapper">
            <a class="modern-button secondary new" href="CreateFood?date=@Model.DateKey">Ny maträtt</a>
            <a class="modern-button secondary edit" href="#" onclick="editFood()">Ändra mat</a>
        </div>
        <div id="sideDishPlaceholder"></div>
        <div class="input-wrapper">
            <span>Vegetarisk</span>
            <input type="checkbox" name="isVego" checked="@Model.DayFood.IsVego" />
        </div>
        <div class="input-wrapper">
            <span>Portioner</span>
            <input type="number" step="any" name="portions" value="@Model.DayFood.Portions.ToString().Replace(',', '.')" />
        </div>

        <div class="button-wrapper">
            <input class="modern-button primary" type="submit" value="Spara mat" />
            @if (Model.CanDelete)
            {
                <button class="modern-button delete" type="button" onclick="deleteFood()">Ta bort</button>
            }
            <button class="modern-button secondary" type="button" onclick="window.location.href = '/WeekFood?' + $('#datekeyFoW').val()">Avbryt</button>
        </div>
    </form>
</div>

<script src="~/js/MultiSelect.js"></script>
<script>
    const sideDishOptions = @Json.Serialize(Model.SideDishes.Select(x => new {
        id = x.Id,
        text = x.Name
    }));

    const existingSideDishIds = @Json.Serialize(Model.DayFood.SideDishes.Select(x => x.Id));

    const sideDishPlaceholder = document.getElementById('sideDishPlaceholder')
    const sideDishHidden = document.getElementById('sideDishIds')
    MultiSelect.create(sideDishOptions, existingSideDishIds, sideDishHidden, sideDishPlaceholder, 'Tillbehör')

    const foodSelect = document.getElementById('foodSelector')
    const autoSearchPlaceholder = document.getElementById('autoSearchPlaceholder')
    const existingFoodOptions = @Json.Serialize(Model.ExistingFood.Select(x => new {
        id = x.Id,
        text = x.Name
    }))
    AutoSearch.create(existingFoodOptions, v => foodSelect.value = v, autoSearchPlaceholder, 'Sök mat..')


     function deleteFood() {
        $('#deleteHidden').val('true')
        document.getElementById('theForm').submit();
    }

    function editFood() {
        const selectedFood = $('#foodSelector').val()
        const date = document.querySelectorAll('#dateKeyCompact')[0].value
        if (selectedFood) {
            window.location = '/CreateFood?date=' + date + '&foodId=' + selectedFood
        }
    }
</script>