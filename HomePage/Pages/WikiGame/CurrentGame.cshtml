@page
@model HomePage.Pages.WikiGame.CurrentGameModel
@{
    ViewData["Title"] = "Dagens Wikipedia race";
}

<link rel="stylesheet" href="~/css/wikigame.css" asp-append-version="true" />

<div class="page-wrapper" style="height: 100vh;">
    <div class="saved-links-wrapper">
    </div>
    <input type="hidden" data-title="@Model.CurrentTitle" id="currentTitle" />
    <span class="step-counter" style="position: absolute; top: 2px;">Sidor besökta: @Model.PreviousClicks</span>
    <button id="back-button" onclick="navigateToPage('GOBACKONCE')" style="position: absolute; top: 50px; left: 0; display: @Model.BackbuttonDisplay">Backa till förra sidan</button>
    <button id="saved-links-button" onclick="pickSavedLinks()" style="position: absolute; top: 50px; right: 0;">Sparade länkar</button>
    <button onclick="window.location.href = 'Results'" style="position: absolute; top: 15px; left: 0;">Tillbaka</button>

    <div class="wiki-container">
        @Html.Raw(Model.PageHtml)
    </div>
</div>

<script src="~/js/Firework.js" asp-append-version="true"></script>
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/js/JsonResultUnpacker.js" asp-append-version="true"></script>
<script src="~/js/WikiGamePageStorage.js" asp-append-version="true"></script>
<script>
    var isNavigating = false
    var storageEntries = loadWikiGameStorage()
    var savedLinks = loadSavedLinks()

    loadScrollPosition()

    if (savedLinks.length === 0) {
        document.getElementById('saved-links-button').style.display = 'none'
    }

    document.addEventListener('click', e => {
        const link = e.target.closest('.wiki-link');
        if (!link || isNavigating) {
            return;
        }

        e.preventDefault();
        const page = link.dataset.page;
        Alert.openDialog('Vill du gå till sidan "' + page.replaceAll('_', ' ') + '"', [
            {text: 'Ja tack!', action: () => {Popup.closePopup(); navigateToPage(page);}},
            {text: 'Spara länk', action: () => {Popup.closePopup(); saveLink(page);}},
            {text: 'Nä', action: () => {Popup.closePopup();}}
        ])
    });

    if ('@Model.HasWon' === 'True') {
         setTimeout(() => shootFireworks(), 800)
    }

    function navigateToPage(pageName) {
        isNavigating = true
        saveScrollPosition()
        Spinner.show()
         $.ajax({
            type: "POST",
            data: {
                pageName: pageName
            },
            url: "/WikiGame/CurrentGame",
            success: (data) => {
                isNavigating = false
                Spinner.hide()
                const result = JsonResultUnpacker.unpackResult(data, window)
                if (!result) {
                    return;
                }

                $('.wiki-container').html(result.html)
                $('.step-counter').text('Sidor besökta: ' + result.steps)
                if (result.isWin) {
                    Alert.openAlert('Jippie!')
                    shootFireworks()
                }

                if (result.canGoBack) {
                    $('#back-button').show()
                } else {
                    $('#back-button').hide()
                }

                document.getElementById('currentTitle').dataset.title = result.title
                savedLinks = loadSavedLinks()
                $('#saved-links-button').toggle(savedLinks.length > 0)
                loadScrollPosition()
            },
            error: () => {
                alert('Någonting gick fel.')
                isNavigating = false
                Spinner.hide()
            }
        });
    }

    function shootFireworks() {
        const clientX = Math.floor(Math.random() * window.innerWidth);
        const clientY = Math.floor(Math.random() * window.innerHeight);
        const counter = 3
        makeFirework(clientX, clientY, counter)
        setTimeout(() => shootFireworks(), 800)
    }

    function makeFirework(clientX, clientY, counter) {
        createFirework(clientX, clientY)
        if (counter > 0) {
            setTimeout(() => createFirework(clientX, clientY, counter - 1), 150)
        }
    }

    function todayDate() {
        return new Date().getDate()
    }

    function loadWikiGameStorage() {
        const storage = localStorage.getItem('WikiGameSavedStorage')
        if (!storage) {
            return []
        }

        entries = JSON.parse(storage)
        return entries.filter(x => x.date == todayDate())
    }

    function loadSavedLinks() {
        const currentTitle = document.getElementById('currentTitle').dataset.title
        const currentPage = storageEntries.filter(x => x.title == currentTitle)

        return currentPage.length > 0 ? currentPage[0].savedLinks : []
    }

    function loadScrollPosition() {
        const currentTitle = document.getElementById('currentTitle').dataset.title
        const currentPage = storageEntries.filter(x => x.title == currentTitle)
        if (currentPage.length > 0) {
            document.querySelectorAll('.wiki-container')[0].scrollTop = currentPage[0].scrollPosition
        } else {
            document.querySelectorAll('.wiki-container')[0].scrollTop = 0
        }
    }

    function saveSavedLinks(links) {
        const currentPage = getOrAddCurrentPageStorage()
        currentPage.savedLinks = links
        localStorage.setItem('WikiGameSavedStorage', JSON.stringify(storageEntries))
    }

    function saveScrollPosition() {
        const currentPage = getOrAddCurrentPageStorage()
        currentPage.scrollPosition = $('.wiki-container').scrollTop()
        localStorage.setItem('WikiGameSavedStorage', JSON.stringify(storageEntries))
    }

    function getOrAddCurrentPageStorage() {
        const currentTitle = document.getElementById('currentTitle').dataset.title
        const filteredPages = storageEntries.filter(x => x.title == currentTitle)
        if (filteredPages.length > 0) {
            return filteredPages[0]
        }
        
        const newPage = new WikiGamePageStorage(todayDate(), currentTitle, savedLinks, null)
        storageEntries.push(newPage)
        return newPage
    }

    function saveLink(link) {
        savedLinks.push(link)
        saveSavedLinks(savedLinks)
        document.getElementById('saved-links-button').style.display = 'block'
    }

    function pickSavedLinks() {
        const buttons = savedLinks.map(x => ({
            text: x.replaceAll('_', ' '),
            action: () => { Popup.closePopup(); navigateToPage(x); }
        }))

        buttons.push(({
            text: 'Avbryt',
            action: () => {Popup.closePopup();}
        }))

        Alert.openDialog('Sparade länkar', buttons)
    }
</script>
