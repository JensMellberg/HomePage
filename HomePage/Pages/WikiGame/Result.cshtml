@page
@using HomePage.Repositories
@model HomePage.Pages.WikiGame.ResultModel
@{
    ViewData["Title"] = "Wikipedia race";
}

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/game-scores.css" asp-append-version="true" />
<div class="page-wrapper game-result-page">
    <div class="game-score-result-wrapper" style="margin-top: 1px;">
        <div class="game-score-result">
            <div class="profile-photo @Model.PersonClass"></div>
            <span>@Model.Score</span>
        </div>
        <button class="modern-button secondary" onclick="window.location.href='Results'" style="height: 32px; margin-top: 8px;">Tillbaka</button>
    </div>

    <div class="path-wrapper">
        @for (var i = 0; i < Model.PathTaken.Count; i++)
        {
            var path = Model.PathTaken[i];
            @if (i == Model.PathTaken.Count - 1)
            {
                if (Model.HasFinished) {
                    <span class="path-item finished"><b>@path</b></span>
                } else {
                    <span class="path-item current"><b>@path</b></span>
                }
                
            }
            else
            {
                <span class="path-item"><b>@path -></b></span>
            }
        }
    </div>
</div>


