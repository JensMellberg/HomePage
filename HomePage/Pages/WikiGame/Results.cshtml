@page
@model HomePage.Pages.WikiGame.ResultsModel
@{
    ViewData["Title"] = "Wikipedia race";
}

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/game-scores.css" asp-append-version="true" />
<div class="page-wrapper wiki-game-page">
    <input type="hidden" data-summary="@Model.Summary" id="summary" />
    <div class="wiki-game-intro">
        <a class="modern-button primary center-button" href="CurrentGame">Dagens sida</a>
        <a class="modern-button secondary center-button" href="Suggestions">Föreslå morgondagens sida</a>
        <div>
            <span>Följ länkarna på wikipediasidorna tills du hittar till sidan för @Model.TodaysGoal. Färre antal klick är bättre.</span>
            <button onclick="showSummary()" class="recipe-button">?</button>
        </div>
    </div>

    @if (Model.TodayResult != null) {
        <div class="word-mix-top-bar">
            <div class="word-mix-other-current">
                @foreach (var entry in Model.TodayResult.Results)
                {
                    if (Model.IsFinished) {
                        <a href="Result?user=@entry.UserName!.EncodeForClient()&date=@DateHelper.ToKey(Model.TodayResult.Date)">@Model.AccountNames[entry.UserName]: @entry.Steps</a>
                    }
                    else {
                        <span>@Model.AccountNames[entry.UserName]: @entry.Steps</span>
                    }
                }
            </div>
        </div>
    }
    
    <div class="word-mix-history-outer">
        @foreach (var dayResult in Model.PreviousResults)
        {
            <div class="word-mix-history-wrapper">
                <div class="wikigame-score-date">
                    <span>@dayResult.Date.Day @DateHelper.MonthNumberToString[dayResult.Date.Month]</span>
                    <span>@dayResult.GoalTitle</span>
                </div>
                <div class="word-mix-other-current">
                    @foreach (var entry in dayResult.Results)
                    {
                        @if (!entry.HasFinished) {
                            <a class="unfinished-score" href="Result?user=@entry.UserName!.EncodeForClient()&date=@DateHelper.ToKey(dayResult.Date)">@Model.AccountNames[entry.UserName]: @entry.Steps (ej i mål)</a>
                        } else {
                            <a href="Result?user=@entry.UserName!.EncodeForClient()&date=@DateHelper.ToKey(dayResult.Date)">@Model.AccountNames[entry.UserName]: @entry.Steps</a>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<script src="~/js/homeButton.js" asp-append-version="true"></script>
<script>
    function showSummary() {
        const notes = document.getElementById("summary").dataset.summary;
        const createNotes = () => {
            const noteWrapper = document.createElement('div');
            const noteElement = document.createElement('span')
            noteElement.innerText = notes
            noteWrapper.className = 'note-wrapper'
            noteWrapper.appendChild(noteElement)
            return noteWrapper
        }

        Popup.putOnOverLay(createNotes(), true, () => { Popup.closePopup(); })
    }
</script>

