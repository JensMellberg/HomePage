@page
@model HomePage.Pages.LoginModel
@{
    ViewData["Title"] = "Logga in";
}

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<div class="page-wrapper mainscreen">
    <a class="modern-button primary new center-button" href="/NewAccount">Skapa konto</a>
    <div class="dayfood-form" method="post">
        <span>Logga in</span>
        <div class="input-wrapper">
            <span>Användarnamn</span>
            <input type="text" id="username" required/>
        </div>
        <div class="input-wrapper">
            <span>Lösenord</span>
            <input type="password" id="password" required />
        </div>

        <div class="button-wrapper">
            <button class="modern-button primary" type="button" onclick="logIn();">Logga in</button>
            <button class="modern-button secondary" type="button" onclick="window.history.back();">Avbryt</button>
        </div>
    </div>
</div>

<script>
    function logIn() {
        const password = $('#password').val()
        const username = $('#username').val()
        $.ajax({
            type: "POST",
            url: "/Login",
            data: {
                username: username,
                password: password
            },
            success: (e) => {
                if (!e.success) {
                    Alert.openAlert('Fel användarnamn eller lösenord.');
                } else {
                    if (e.url) {
                        window.location.href = e.url;
                    } else {
                        window.location.href = '/Index'
                    }
                }
            }
        });
    }
</script>