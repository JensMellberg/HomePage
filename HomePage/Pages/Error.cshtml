@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger" style="margin-top: 40px">Error.</h1>
<h2 class="text-danger">Något gick oväntat fel :(</h2>

<button onclick="window.location = '/index'" class="home-button" type="button">Hem</button>
@foreach (var error in Model.Errors) {
    <p>@error</p>
}