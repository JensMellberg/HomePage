@page
@model HomePage.Pages.CreateShoppingListModel
@{
	ViewData["Title"] = "Handlingslista";
}

<div class="page-wrapper shopping-list-page">
    <div class="shopping-list-actions">
        <button class="modern-button primary" type="button" onclick="copyShoppingList()">Kopiera</button>
        <button class="modern-button secondary" type="button" onclick="addToStorage()">Lägg till i skafferi</button>
        <button class="modern-button secondary" type="button" onclick="window.history.back();">Tillbaka</button>
    </div>

    <div class="shopping-list" id="shoplist">
    </div>
</div>

<link rel="stylesheet" href="~/css/modern-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shopping-list.css" asp-append-version="true" />
<script src="~/js/IngredientInstance.js" asp-append-version="true"></script>
<script src="~/js/JsonResultUnpacker.js" asp-append-version="true"></script>
<script>
        var possibleIngredients = IngredientInstance.decodePossibleIngredients('@Html.Raw(Model.PossibleIngredients)')
        var unitTypes = JSON.parse('@Html.Raw(Model.AllUnitValues)')
        var categories = '@Html.Raw(string.Join(',', IngredientCategory.Categories.OrderBy(x => x)))'.split(',')
        var existing = JSON.parse('@Html.Raw(Model.IngredientsJson)')
        var allRows = []
        var wrapper = document.getElementById('shoplist')
        for (const ingredient of existing) {
            const rowWrapper = document.createElement('div')
            rowWrapper.className = 'input-wrapper'

            let instance = IngredientInstance.create(categories, possibleIngredients, unitTypes, ingredient.id, ingredient.amount, ingredient.unit, ingredient.category)
            let elements = instance.createElements(false)
            let span = document.createElement('span')
            let ingredientActual = possibleIngredients.find(x => x.id == ingredient.id)
            span.innerText = ingredientActual.name
            rowWrapper.appendChild(span)
            rowWrapper.appendChild(elements.ingredientAmountRow)

            if (ingredient.isSkipped) {
                instance.amountInput.disabled = true;
                instance.unitDropdown.disabled = true;
                span.style.color = 'grey'
            } else {
                allRows.push(instance)
                const deleteButton = document.createElement('button')
                deleteButton.type = 'button'
                deleteButton.innerText = 'X'
                rowWrapper.appendChild(deleteButton)
                deleteButton.onclick = () => {
                    allRows = allRows.filter(x => x !== instance)
                    rowWrapper.remove()
                    return false
                }
            }

            wrapper.appendChild(rowWrapper)
        }

    function copyShoppingList() {
        const getNameFromIngredientId = id => {
            return possibleIngredients.filter(x => x.id === id)[0].name
        }

        const ingredients = allRows.map(x => x.getIngredient()).map(x => ({ name: getNameFromIngredientId(x.id), unit: x.unit, amount: x.amount }))
        const shoppingListText = ingredients.map(x => x.name + ' ' + x.amount + ' ' + x.unit).join('\n')
        const textarea = document.createElement('textarea');
        textarea.value = shoppingListText;
        textarea.style.position = 'fixed';
        textarea.style.opacity = 0;
        document.body.appendChild(textarea);
        textarea.select();

        try {
            document.execCommand('copy');
            alert('Kopierat!');
        } catch (err) {
            console.error('Copy failed:', err);
        }

        document.body.removeChild(textarea);
    }

    function addToStorage() {
           const ingreds = allRows.map(x => x.getIngredient())
             $.ajax({
                type: "POST",
                url: "/CreateShoppingList",
                data: {
                    ingredients: ingreds,
                    action: 'addToStorage'
                },
                success: (data) =>  { 
                    const result = JsonResultUnpacker.unpackResult(data, window)
                    if (result?.success) {
                        alert('Tillagt i skafferi!');
                        $('.input-wrapper').remove()
                    }
                }
            });
    }
</script>